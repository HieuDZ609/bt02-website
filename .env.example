# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.

# 1. Tạo webhook Discord: server -> Settings -> Integrations -> Webhooks ->
#    New Webhook -> Copy Webhook URL. App Discord phải bật thông báo trên iPhone.
DISCORD_WEBHOOK_URL=

# 2. Mật khẩu trang quản trị /admin (đổi tuỳ ý).
ADMIN_PASSWORD=

# 3. SECRET_KEY ký session cookie. Tạo bằng:
#    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 4. Ngrok authtoken (dashboard -> Your Authtoken) - dùng static domain cố định
NGROK_AUTHTOKEN=

# Cấu hình ứng dụng
PORT=8000
MAX_LEN=500
RATE_LIMIT_SECONDS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
DEFAULT_BANNER=Chào mừng bạn đến với website cá nhân của mình!