# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.

# Có thể bật 1 hoặc cả 2 kênh thông báo; khách gửi form sẽ push tới tất cả
# kênh đang cấu hình.

# 1a. Discord Webhook: server -> Settings -> Integrations -> Webhooks ->
#     New Webhook -> Copy Webhook URL. App Discord phải bật thông báo trên iPhone.
DISCORD_WEBHOOK_URL=

# 1b. Telegram Bot (nhận thông báo khách + đổi banner từ điện thoại):
#     - Nhắn @BotFather -> /newbot -> lấy BOT_TOKEN.
#     - Nhắn /start cho bot của bạn rồi chạy lệnh sau để lấy chat_id:
#       curl -s "https://api.telegram.org/bot<BOT_TOKEN>/getUpdates"
#       (đọc result[].message.chat.id) - hoặc nhắn @userinfobot.
#     - TELEGRAM_ADMIN_ID: chat_id của bạn (được phép đổi banner).
#     - TELEGRAM_CHAT_ID: nơi nhận thông báo khách (bỏ trống = dùng ADMIN_ID).
#     Sau khi cấu hình, nhắn "/banner <nội dung>" cho bot để đổi banner.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CHAT_ID=

# 2. Mật khẩu trang quản trị /admin (đổi tuỳ ý).
ADMIN_PASSWORD=

# 3. SECRET_KEY ký session cookie. Tạo bằng:
#    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 4. Ngrok authtoken (dashboard -> Your Authtoken) - dùng static domain cố định
NGROK_AUTHTOKEN=

# Cấu hình ứng dụng
PORT=8000
MAX_LEN=500
RATE_LIMIT_SECONDS=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60
DEFAULT_BANNER=Chào mừng bạn đến với website cá nhân của mình!